# nodi — environment for `docker compose` (copy to .env; works unchanged for a
# local demo). Never commit the real .env.
#
# There is NO server-side AI key: every user enters their own Gemini API key in
# the web UI; it is sent per request and never stored on the server.

# --- PostgreSQL (the `db` service) ---
POSTGRES_USER=nodi
POSTGRES_PASSWORD=nodi
POSTGRES_DB=nodi

# Connection string used by the backend and the migration job (host `db` is the
# compose service). Keep user / password / database in sync with the values
# above (URL-encode special characters in the password).
DATABASE_URL=postgres://nodi:nodi@db:5432/nodi?sslmode=disable

# --- Auth (session cookie) ---
# Secret used to sign login sessions (at least 32 characters). If left empty,
# the backend generates a random one on each start, so logins end whenever the
# backend restarts. Set one for any shared deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Session lifetime in days.
JWT_EXPIRE_DAYS=7
# true when the site is served over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=false

# --- Browser origins allowed to call the backend directly (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- File storage ---
# Inside Docker, uploads always live in the `uploads` volume at /data/uploads.
# This value only matters when running the backend outside Docker.
STORAGE_DIR=/data/uploads

# Host port for the backend API.
BACKEND_PORT=8000

# Host port for the web app (open http://localhost:3000). If you change it, also
# add the new origin to CORS_ORIGINS above.
WEB_PORT=3000
